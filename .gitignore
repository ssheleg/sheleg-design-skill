node_modules/
*.log
.DS_Store
*.tgz
# `.claude/*`, not `.claude/`: git cannot re-include a file whose parent
# DIRECTORY is excluded, so the `!.claude/agent-sync.json` negation below was
# inert against `.claude/` and survived only because the file was already
# tracked. Excluding the contents instead makes the negation real.
.claude/*

# Reference-kit build output. The kits ship as source in the npm package
# (ADR-0002); dist/ is regenerated by whoever materializes one, and a lockfile
# would pin deps CI installs with --no-save anyway.
kits/*/dist/
kits/*/package-lock.json

# Knowledge graph output — regenerated by /graphify, machine state not source.
graphify-out/

# Byte-code from importing the gates. Measuring a pack's colours by importing
# validate_palette.py — rather than reimplementing its maths and getting a
# second answer — is the documented technique, and this is its only residue.
__pycache__/


# Scratch measurement output. A run measures a reference and screenshots it;
# 646KB of one entered history through a `git add -A` (board B-015).
.tmp*

# agent-sync run state — per-machine, never shared
.agent-sync/

# ...except the coordination config, which is shared state, not local Claude state.
# The rest of .claude/ stays ignored deliberately; this one file has no other home,
# because agent-sync resolves a project by `<root>/.claude/agent-sync.json` and nowhere else.
!.claude/agent-sync.json

# agent-sync — local credentials and run state, never committed
.env.agent-sync
