node_modules/
*.log
.DS_Store
*.tgz
.claude/

# Reference-kit build output. The kits ship as source in the npm package
# (ADR-0002); dist/ is regenerated by whoever materializes one, and a lockfile
# would pin deps CI installs with --no-save anyway.
kits/*/dist/
kits/*/package-lock.json

# Knowledge graph output — regenerated by /graphify, machine state not source.
graphify-out/

# Byte-code from importing the gates. Measuring a pack's colours by importing
# validate_palette.py — rather than reimplementing its maths and getting a
# second answer — is the documented technique, and this is its only residue.
__pycache__/


# Scratch measurement output. A run measures a reference and screenshots it;
# 646KB of one entered history through a `git add -A` (board B-015).
.tmp*
